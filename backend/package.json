{
  "name": "autowork-backend",
  "version": "1.0.0",
  "description": "Autowork.com NestJS Multi-Tenant SaaS Backend",
  "author": "Autowork Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate --schema=../prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=../prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=../prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema=../prisma/schema.prisma",
    "worker:campaign": "ts-node -r dotenv/config ../workers/campaign.worker.entry.ts",
    "worker:pcloud": "ts-node -r dotenv/config ../workers/pcloud-share.worker.entry.ts",
    "worker:email": "ts-node -r dotenv/config ../workers/email-dispatch.worker.entry.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/platform-socket.io": "10.4.22",
    "@nestjs/swagger": "7.3.1",
    "@prisma/client": "5.22.0",
    "bcrypt": "5.1.1",
    "bullmq": "5.1.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "16.4.5",
    "exceljs": "4.4.0",
    "ioredis": "5.3.2",
    "nodemailer": "^9.0.5",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "4.7.4"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.22",
    "@swc/core": "1.7.36",
    "@types/bcrypt": "5.0.2",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/node": "20.11.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prettier": "3.2.5",
    "source-map-support": "0.5.21",
    "ts-jest": "29.1.2",
    "ts-loader": "9.5.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "roots": [
      "<rootDir>",
      "<rootDir>/../tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
