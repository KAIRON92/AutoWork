# AutoWork pCloud worker Dockerfile
FROM node:20-bookworm-slim AS builder

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY backend/package*.json ./
RUN npm ci --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=2000 --fetch-retry-maxtimeout=120000

COPY backend/ ./backend/
COPY prisma ./prisma
COPY workers ./workers
RUN npx prisma generate --schema=./prisma/schema.prisma
RUN npm --prefix ./backend run build

FROM node:20-bookworm-slim AS runner
WORKDIR /app/backend

ENV NODE_ENV=production
ENV NODE_PATH=/app/node_modules
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/* \
  && groupadd --system autowork \
  && useradd --system --gid autowork --create-home autowork

COPY --from=builder /app/backend/package*.json ./
COPY --from=builder /app/backend/dist ./dist
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/prisma ../prisma
COPY --from=builder /app/backend/src ./src
COPY --from=builder /app/workers ../workers
RUN chown -R autowork:autowork /app
USER autowork

CMD ["npx", "ts-node", "--transpile-only", "../workers/pcloud-share.worker.entry.ts"]
