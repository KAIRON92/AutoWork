# AutoWork SaaS environment template
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

DATABASE_URL="postgresql://autowork:autoworkpass@localhost:5432/autowork_db?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Generate unique values; never commit real secrets.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=replace-with-a-long-random-secret

# pCloud integration
# Real pCloud is the default. Mock mode is disabled unless explicitly enabled.
PCLOUD_DEFAULT_PROVIDER=pcloud
PCLOUD_ALLOW_MOCK=false
PCLOUD_API_URL=https://api.pcloud.com
PCLOUD_API_HOST=https://api.pcloud.com
PCLOUD_CLIENT_ID=replace-with-pcloud-app-client-id
PCLOUD_CLIENT_SECRET=replace-with-pcloud-app-client-secret
PCLOUD_ACCESS_TOKEN=
PCLOUD_DEFAULT_FOLDER_ID=0

# REQUIRED for real pCloud accounts. Base64-encoded 32-byte AES-256-GCM key.
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { [byte](Get-Random -Minimum 0 -Maximum 256) }))
PCLOUD_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key

WEBSOCKET_PORT=4001
