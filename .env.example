# Autowork.com SaaS - Environment Configuration

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/autowork_db?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=replace-with-a-long-random-secret

# pCloud Platform Engine
PCLOUD_DEFAULT_PROVIDER=mock_pcloud
PCLOUD_API_URL=https://api.pcloud.com
PCLOUD_API_HOST=https://api.pcloud.com
PCLOUD_CLIENT_ID=replace-with-pcloud-app-client-id
PCLOUD_CLIENT_SECRET=replace-with-pcloud-app-client-secret
PCLOUD_ACCESS_TOKEN=replace-with-server-side-token-if-used
PCLOUD_DEFAULT_FOLDER_ID=0
# Base64-encoded 32-byte key used to encrypt real pCloud credentials at rest
PCLOUD_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key

WEBSOCKET_PORT=4001
