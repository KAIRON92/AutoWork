# Autowork.com SaaS - Environment Configuration

# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL / SQLite for local fallback)
DATABASE_URL="postgresql://autowork:autoworkpass@localhost:5432/autowork_db?schema=public"

# Redis & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=super-secret-jwt-token-key-autowork-2026
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=super-secret-refresh-key-autowork-2026

# Storage Provider — pCloud REST API (CONFIRMED)
# Set your real pCloud keys below when provided by client
PCLOUD_CLIENT_ID=placeholder_pcloud_client_id
PCLOUD_CLIENT_SECRET=placeholder_pcloud_client_secret
PCLOUD_ACCESS_TOKEN=placeholder_pcloud_access_token
PCLOUD_FOLDER_ID=0
PCLOUD_API_HOST=https://api.pcloud.com

# Email Provider Configuration (Active: Fake Provider)
EMAIL_PROVIDER_ACTIVE=fake
FAKE_EMAIL_SIMULATED_LATENCY_MS=150
FAKE_EMAIL_SUCCESS_RATE=0.98

# Socket.IO Realtime
WEBSOCKET_PORT=4001
