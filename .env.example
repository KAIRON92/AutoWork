# Autowork.com SaaS - Environment Configuration

# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://autowork:autoworkpass@localhost:5432/autowork_db?schema=public"

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=super-secret-jwt-token-key-autowork-2026
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=super-secret-refresh-key-autowork-2026

# pCloud Platform Engine
PCLOUD_DEFAULT_PROVIDER=mock_pcloud
PCLOUD_API_URL=https://api.pcloud.com
PCLOUD_CLIENT_ID=placeholder_pcloud_client_id
PCLOUD_CLIENT_SECRET=placeholder_pcloud_client_secret
PCLOUD_ACCESS_TOKEN=placeholder_pcloud_access_token
PCLOUD_DEFAULT_FOLDER_ID=0

# Socket.IO Realtime
WEBSOCKET_PORT=4001
