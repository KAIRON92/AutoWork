// Autowork.com - Multi-Tenant pCloud Automation Schema Definition

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

model Organization {
  id                 String                  @id @default(uuid())
  name               String
  slug               String                  @unique
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  users              User[]
  roles              Role[]
  permissions        Permission[]
  pcloudAccounts     PCloudAccount[]
  pcloudFiles        PCloudFile[]
  contacts           Contact[]
  contactLists       ContactList[]
  importJobs         ImportJob[]
  templates          Template[]
  automations        Automation[]
  automationVersions AutomationVersion[]
  campaigns          Campaign[]
  automationJobs     AutomationJob[]
  pcloudExecutions   PCloudShareExecution[]
  errorLogs          ErrorLog[]
  auditLogs          AuditLog[]
}

model Role {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  permissions    Permission[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Permission {
  id             String       @id @default(uuid())
  organizationId String
  action         String
  resource       String
  roleId         String?
  role           Role?        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  firstName      String
  lastName       String
  organizationId String
  roleId         String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model PCloudAccount {
  id             String                 @id @default(uuid())
  organizationId String
  name           String
  accountEmail   String
  provider       String                 @default("pcloud")
  status         String                 @default("ACTIVE")
  dailyLimit     Int                    @default(500)
  sentToday      Int                    @default(0)
  credentials    String                 // AES-256-GCM encrypted credential for real pCloud; mock provider may use a mock token
  pcloudUserId   String?
  folderId       String?                @default("0")
  lastUsedAt     DateTime?
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pcloudFiles    PCloudFile[]
  campaigns      Campaign[]
  executions     PCloudShareExecution[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([organizationId])
  @@index([status])
}

model PCloudFile {
  id              String                 @id @default(uuid())
  organizationId  String
  pcloudAccountId String?
  name            String
  fileId          String
  folderId        String?                @default("0")
  fileSize        Int                    @default(0)
  mimeType        String                 @default("application/octet-stream")
  pcloudPath      String?
  metadata        String?
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pcloudAccount   PCloudAccount?         @relation(fields: [pcloudAccountId], references: [id], onDelete: SetNull)
  campaigns       Campaign[]
  executions      PCloudShareExecution[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([organizationId])
  @@index([pcloudAccountId])
}

model Contact {
  id             String              @id @default(uuid())
  organizationId String
  email          String
  firstName      String?
  lastName       String?
  fullName       String?
  phone          String?
  company        String?
  target         String?
  tags           String?
  customFields   String?
  source         String?             @default("manual")
  status         String              @default("ACTIVE")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    ContactListMember[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
}

model ContactList {
  id             String              @id @default(uuid())
  organizationId String
  name           String
  description    String?
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ContactListMember[]
  campaigns      Campaign[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
}

model ContactListMember {
  contactId     String
  contactListId String
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactList   ContactList @relation(fields: [contactListId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([contactId, contactListId])
  @@index([contactListId])
}

model ImportJob {
  id             String       @id @default(uuid())
  organizationId String
  filename       String
  status         String
  totalRows      Int          @default(0)
  importedCount  Int          @default(0)
  failedCount    Int          @default(0)
  duplicateCount Int          @default(0)
  errors         String?
  detectedMap    String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Template {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  content        String
  variables      String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns      Campaign[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Campaign {
  id              String                 @id @default(uuid())
  organizationId  String
  name            String
  status          String                 @default("DRAFT")
  pcloudAccountId String
  pcloudFileId    String
  templateId      String
  contactListId   String?
  totalCount      Int                    @default(0)
  sharedCount     Int                    @default(0)
  failedCount     Int                    @default(0)
  retryingCount   Int                    @default(0)
  config          String?
  pcloudAccount   PCloudAccount          @relation(fields: [pcloudAccountId], references: [id], onDelete: Restrict)
  pcloudFile      PCloudFile             @relation(fields: [pcloudFileId], references: [id], onDelete: Restrict)
  template        Template               @relation(fields: [templateId], references: [id], onDelete: Restrict)
  contactList     ContactList?           @relation(fields: [contactListId], references: [id], onDelete: SetNull)
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipients      CampaignRecipient[]
  executions      PCloudShareExecution[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([organizationId])
  @@index([status])
}

model CampaignRecipient {
  id                      String                 @id @default(uuid())
  campaignId              String
  contactId               String
  recipientEmail          String
  status                  String                 @default("PENDING")
  pcloudShareExecutionId  String?
  resolvedDescription     String?
  randomCode              String?
  errorCode               String?
  errorMessage            String?
  campaign                Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([campaignId])
  @@index([status])
}

model Automation {
  id             String              @id @default(uuid())
  organizationId String
  name           String
  status         String              @default("DRAFT")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       AutomationVersion[]
  jobs           AutomationJob[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model AutomationVersion {
  id           String      @id @default(uuid())
  automationId String
  version      Int
  definition   String
  automation   Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@unique([automationId, version])
}

model AutomationJob {
  id             String       @id @default(uuid())
  organizationId String
  automationId   String
  status         String       @default("QUEUED")
  payload        String?
  result         String?
  error          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automation     Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  @@index([organizationId])
  @@index([status])
}

model PCloudShareExecution {
  id                String        @id @default(uuid())
  organizationId    String
  campaignId        String
  recipientId       String
  pcloudAccountId   String
  pcloudFileId      String
  recipientEmail    String
  descriptionSnapshot String
  operationType     String
  status            String
  pcloudReferenceId String?
  errorCode         String?
  errorMessage      String?
  startedAt         DateTime      @default(now())
  completedAt       DateTime?
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign          Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  pcloudAccount     PCloudAccount @relation(fields: [pcloudAccountId], references: [id], onDelete: Restrict)
  pcloudFile        PCloudFile    @relation(fields: [pcloudFileId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([campaignId])
  @@index([pcloudAccountId])
  @@index([recipientEmail])
  @@index([status])
}

model ErrorLog {
  id             String       @id @default(uuid())
  organizationId String
  level          String
  message        String
  context        String?
  stack          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([level])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  actorUserId    String?
  action         String
  resource       String
  resourceId     String?
  metadata       String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([createdAt])
}
